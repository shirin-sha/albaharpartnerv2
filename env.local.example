# MongoDB Connection
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/albahar

# For MongoDB Atlas (uncomment and replace with your connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/albahar?retryWrites=true&w=majority

# Admin Creation Secret (for /api/admin/create-admin endpoint)
# Set a strong secret key to protect the admin creation endpoint
ADMIN_CREATE_SECRET=your-secret-key-change-this-in-production

# Optional: Default admin credentials (used by create-admin script)
# These are only used if you run: node scripts/create-admin.js
ADMIN_EMAIL=admin@albahar.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User
